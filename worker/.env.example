# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://brwulcgtlgbuqsesbuvq.supabase.co
# Secret: la clave secreta (empieza por sb_secret_)
SUPABASE_SECRET_KEY=

# Cloudflare R2 (los mismos valores que pusiste en Vercel)
R2_ENDPOINT=
# Secret
R2_ACCESS_KEY_ID=
# Secret
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mova-videos

# TikTok (los mismos valores que en Vercel), para renovar la conexión al publicar
TIKTOK_CLIENT_KEY=
# Secret
TIKTOK_CLIENT_SECRET=

# Opcional
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   (hasta que TikTok apruebe la app se publica en privado)
# PUBLISH_SECONDS=30
# WHISPER_LANGUAGE=es
# THREADS=4
# POLL_SECONDS=10
# GUARDAR_COPIA=1
